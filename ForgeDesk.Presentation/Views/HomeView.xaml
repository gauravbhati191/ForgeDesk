<UserControl x:Class="ForgeDesk.Presentation.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ForgeDesk.Presentation.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,36">
            <TextBlock Text="START HERE" Style="{StaticResource PageEyebrowStyle}" />
            <TextBlock Margin="0,8,0,0"
                       Text="{Binding Title}"
                       Style="{StaticResource PageTitleStyle}" />
            <TextBlock Margin="0,8,0,0"
                       MaxWidth="680"
                       Text="{Binding Description}"
                       Style="{StaticResource PageSubtitleStyle}" />

            <Border Margin="0,28,0,0"
                    Padding="22"
                    Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" MaxWidth="560">
                        <TextBlock Text="Your first project" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding PrimaryActionTitle}"
                                   Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="ForgeDesk keeps project context visible while you move through the workspace."
                                   Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            MinWidth="150"
                            Margin="24,0,0,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Open a project folder"
                            Command="{Binding DataContext.Projects.OpenProjectCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Content="Open project"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
            </Border>

            <UniformGrid Margin="0,18,0,0" Columns="3">
                <Border Margin="0,0,8,0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <controls:VectorIcon Width="24"
                                             Height="24"
                                             IconKey="Icon.Projects"
                                             Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Margin="0,14,0,0"
                                   Text="{Binding WorkspaceCardTitle}"
                                   Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding WorkspaceCardDescription}"
                                   Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Margin="4,0,4,0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <controls:VectorIcon Width="24"
                                             Height="24"
                                             IconKey="Icon.Health"
                                             Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Margin="0,14,0,0"
                                   Text="{Binding AnalysisCardTitle}"
                                   Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding AnalysisCardDescription}"
                                   Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Margin="8,0,0,0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <controls:VectorIcon Width="24"
                                             Height="24"
                                             IconKey="Icon.Reports"
                                             Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Margin="0,14,0,0"
                                   Text="{Binding DeliveryCardTitle}"
                                   Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding DeliveryCardDescription}"
                                   Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
