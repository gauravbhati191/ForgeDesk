<UserControl x:Class="ForgeDesk.Presentation.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ForgeDesk.Presentation.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,36">
            <TextBlock Text="PREFERENCES" Style="{StaticResource PageEyebrowStyle}" />
            <TextBlock Margin="0,8,0,0"
                       Text="Settings"
                       Style="{StaticResource PageTitleStyle}" />
            <TextBlock Margin="0,8,0,0"
                       Text="Tune the shell without changing project behavior."
                       Style="{StaticResource PageSubtitleStyle}" />

            <Border Margin="0,26,0,0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:VectorIcon Grid.Column="0"
                                         Width="28"
                                         Height="28"
                                         Margin="0,2,16,0"
                                         VerticalAlignment="Top"
                                         IconKey="Icon.Settings"
                                         Foreground="{DynamicResource AccentBrush}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Theme" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding ThemeDescription}"
                                   Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Margin="0,10,0,0"
                                   Text="Current theme:"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Margin="0,2,0,0"
                                   Text="{Binding CurrentThemeLabel}"
                                   Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            MinWidth="170"
                            Margin="24,0,0,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Switch application theme"
                            Command="{Binding ToggleThemeCommand}"
                            Content="{Binding ThemeButtonLabel}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>
            </Border>

            <TextBlock Margin="0,16,0,0"
                       Text="{Binding StatusMessage}"
                       Style="{StaticResource BodyTextStyle}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
