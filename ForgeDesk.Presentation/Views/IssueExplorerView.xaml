<UserControl x:Class="ForgeDesk.Presentation.Views.IssueExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ForgeDesk.Presentation.Views">
    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="CODE HEALTH" Style="{StaticResource PageEyebrowStyle}" />
                <TextBlock Margin="0,6,0,0" Text="Issue explorer" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Margin="0,6,0,0"
                           Text="Search, filter, and navigate the actual persisted findings for the selected analysis scan."
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <Button Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Refresh persisted issues"
                    Command="{Binding RefreshCommand}"
                    Content="Refresh"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </Grid>

        <Border Grid.Row="1"
                Margin="0,18,0,14"
                Padding="12"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <WrapPanel>
                <TextBox Width="220"
                         Margin="0,0,8,0"
                         Padding="8,5"
                         AutomationProperties.Name="Search findings"
                         ToolTip="Search finding messages, rule IDs, paths, and symbols"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Width="118"
                          Margin="0,0,8,0"
                          AutomationProperties.Name="Filter finding severity"
                          ItemsSource="{Binding SeverityOptions}"
                          SelectedItem="{Binding SeverityFilter, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Width="120"
                          Margin="0,0,8,0"
                          AutomationProperties.Name="Filter finding rule"
                          ItemsSource="{Binding RuleOptions}"
                          SelectedItem="{Binding RuleFilter, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Width="190"
                          Margin="0,0,8,0"
                          AutomationProperties.Name="Filter finding file"
                          ItemsSource="{Binding FileOptions}"
                          SelectedItem="{Binding FileFilter, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Width="122"
                          Margin="0,0,8,0"
                          AutomationProperties.Name="Sort findings"
                          ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SortBy, UpdateSourceTrigger=PropertyChanged}" />
                 <Button Margin="0,0,8,0"
                         AutomationProperties.Name="Clear issue filters"
                         Command="{Binding ClearFiltersCommand}"
                         Content="Clear filters"
                         Style="{StaticResource SecondaryButtonStyle}" />
                 <TextBlock Margin="4,7,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource AccentBrush}"
                            Text="{Binding RelatedSymbolLabel}"
                            Visibility="{Binding HasRelatedSymbolFilter, Converter={StaticResource BooleanToVisibilityConverter}}" />
                 <TextBlock Margin="4,7,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding CountSummary}"
                           Style="{StaticResource BodyTextStyle}" />
                <TextBlock Margin="12,7,0,0"
                           MaxWidth="360"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}"
                           Text="{Binding StateMessage}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding ShowPartial, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="10"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{Binding ShowResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ListBox AutomationProperties.Name="Persisted findings"
                         ItemsSource="{Binding VisibleFindings}"
                         SelectedItem="{Binding SelectedFinding, Mode=TwoWay}"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Padding="12"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding RuleId}"
                                                   Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="12,0,0,0"
                                                   Text="{Binding SeverityLabel}"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   FontWeight="SemiBold" />
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                               Margin="0,6,0,0"
                                               Text="{Binding Message}"
                                               Style="{StaticResource BodyTextStyle}"
                                               TextWrapping="Wrap" />
                                    <Grid Grid.Row="2" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding SymbolLabel}"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="12,0,0,0"
                                                   Text="{Binding LocationLabel}"
                                                   Foreground="{DynamicResource SubtleTextBrush}"
                                                   FontSize="11"
                                                   TextAlignment="Right" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Border Grid.Column="0"
                    Padding="20"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{Binding ShowFilteredEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="No persisted findings match the current filters." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
            </Border>

            <Border Grid.Column="0"
                    Padding="20"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{Binding ShowNoProject, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding StateMessage}" Style="{StaticResource BodyTextStyle}" />
            </Border>
            <Border Grid.Column="0"
                    Padding="20"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{Binding ShowEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="No persisted findings" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Margin="0,5,0,0" Text="{Binding StateMessage}" Style="{StaticResource BodyTextStyle}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="0"
                    Padding="20"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{Binding ShowError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Issues unavailable" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Margin="0,5,0,0" Text="{Binding StateMessage}" Style="{StaticResource BodyTextStyle}" />
                    <TextBlock Margin="0,5,0,0" Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                    </StackPanel>
            </Border>
            <Border Grid.Column="0"
                    Padding="20"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{Binding ShowCancelled, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding StateMessage}" Style="{StaticResource BodyTextStyle}" />
            </Border>

            <Border Grid.Column="2"
                    Padding="16"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="ISSUE DETAILS" Style="{StaticResource PageEyebrowStyle}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding SelectedFindingDetails}"
                                   Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,14,0,0" Text="Source location" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="{Binding SelectedFindingLocation}"
                                   Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap" />
                         <TextBlock Margin="0,14,0,0" Text="Associated symbol" Style="{StaticResource FieldLabelStyle}" />
                         <TextBlock Margin="0,3,0,0" Text="{Binding SelectedFinding.SymbolLabel}" Style="{StaticResource BodyTextStyle}" />
                         <TextBlock Margin="0,14,0,0" Text="Analysis run" Style="{StaticResource FieldLabelStyle}" />
                         <TextBlock Margin="0,3,0,0" Text="{Binding SelectedFinding.AnalysisRunLabel}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                         <StackPanel Margin="0,16,0,0">
                            <Button Margin="0,0,0,7"
                                    AutomationProperties.Name="Open finding source"
                                    Command="{Binding OpenSelectedSourceCommand}"
                                    Content="Open source preview"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Button AutomationProperties.Name="Navigate to finding symbol in graph"
                                    Command="{Binding NavigateToGraphCommand}"
                                    Content="Show symbol in graph"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                        <TextBlock Margin="0,18,0,0"
                                   Text="Select a finding to see its persisted message, rule, severity, symbol, and source line."
                                   Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <views:SourceViewerView Grid.Row="3"
                                Margin="0,14,0,0"
                                DataContext="{Binding SourceViewer}" />
    </Grid>
</UserControl>
