<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>ForgeDesk.Presentation</RootNamespace>
    <AssemblyName>ForgeDesk.Presentation</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The presentation shell consumes application contracts through this boundary. -->
    <ProjectReference Include="..\ForgeDesk.Application\ForgeDesk.Application.csproj" />
    <!-- Graph UI consumes the public read/query contracts without editing the graph core. -->
    <ProjectReference Include="..\ForgeDesk.Graph\ForgeDesk.Graph.csproj" />
  </ItemGroup>
</Project>
