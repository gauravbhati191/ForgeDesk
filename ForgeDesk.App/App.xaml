<Application x:Class="ForgeDesk.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ForgeDesk.Presentation.ViewModels;assembly=ForgeDesk.Presentation"
             xmlns:views="clr-namespace:ForgeDesk.Presentation.Views;assembly=ForgeDesk.Presentation"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ForgeDesk.Presentation;component/Resources/Themes/Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/ForgeDesk.Presentation;component/Resources/Icons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/ForgeDesk.Presentation;component/Resources/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProjectsViewModel}">
                <views:ProjectsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AnalysisViewModel}">
                <views:AnalysisView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DependencyGraphViewModel}">
                <views:DependencyGraphView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:IssueExplorerViewModel}">
                <views:IssueExplorerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GitChangesViewModel}">
                <views:GitChangesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                <views:ReportsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UnavailablePageViewModel}">
                <views:UnavailablePageView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
