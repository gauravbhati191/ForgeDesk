<Window x:Class="ForgeDesk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ForgeDesk.Presentation.Controls;assembly=ForgeDesk.Presentation"
        Title="ForgeDesk"
        MinWidth="980"
        MinHeight="640"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.Name="ForgeDesk workspace">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16,18,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border Width="32"
                            Height="32"
                            Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="8">
                        <controls:VectorIcon Width="18"
                                             Height="18"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             IconKey="Icon.Home"
                                             Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   Text="ForgeDesk" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="Developer workspace" />
                    </StackPanel>
                </StackPanel>

                <ListBox Grid.Row="2"
                         AutomationProperties.Name="Workspace navigation"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedValue="{Binding CurrentPage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         SelectedValuePath="Page"
                         ItemContainerStyle="{StaticResource NavigationListBoxItemStyle}"
                         Style="{StaticResource NavigationListBoxStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <controls:VectorIcon Width="18"
                                                     Height="18"
                                                     Margin="0,0,11,0"
                                                     VerticalAlignment="Center"
                                                     IconKey="{Binding IconKey}"
                                                     Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock VerticalAlignment="Center"
                                           AutomationProperties.Name="{Binding Label}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextBrush}"
                                           Text="{Binding Label}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="3"
                        Padding="12"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                    Foreground="{DynamicResource MutedTextBrush}"
                                     Text="PHASE 4 WORKSPACE" />
                        <TextBlock Margin="0,5,0,0"
                                   FontSize="11"
                                    Foreground="{DynamicResource SubtleTextBrush}"
                                    Text="Persisted analysis, graph, and issue workspace"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{DynamicResource WindowBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="30,22,30,18"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Margin="0,5,0,0"
                                   Text="{Binding PageSubtitle}"
                                   Style="{StaticResource PageSubtitleStyle}" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            MinWidth="160"
                            Margin="20,0,0,0"
                            Padding="12,8"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            AutomationProperties.Name="Current project context">
                        <StackPanel Orientation="Horizontal">
                            <controls:VectorIcon Width="18"
                                                 Height="18"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"
                                                 IconKey="Icon.Projects"
                                                 Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="{Binding ProjectContextLabel}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentPageViewModel}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />

            <Border Grid.Row="2"
                    MinHeight="38"
                    Padding="18,8"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <ProgressBar Width="56"
                                     Height="4"
                                     Margin="0,0,9,0"
                                     VerticalAlignment="Center"
                                     IsIndeterminate="True"
                                     AutomationProperties.Name="Workspace busy indicator"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{Binding StatusMessage}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Margin="18,0,18,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource DangerBrush}"
                               Text="{Binding ErrorMessage}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               FontSize="11"
                                Foreground="{DynamicResource SubtleTextBrush}"
                                  Text="ForgeDesk Phase 4" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
